@page "/"
@inject NavigationManager Navigation
<PageTitle>Главная страница</PageTitle>

<h1>Hello, world!</h1>
<button class="btn btn-dark" @onclick="SingnUp">Зарегестрироваться</button>
<button class="btn btn-primary" @onclick="Login">Войти</button>

@code {
    private void SingnUp()
    {
        Navigation.NavigateTo("/Signup");
    }
    private void Login()
    {
        Navigation.NavigateTo("/Login");
    }
}
